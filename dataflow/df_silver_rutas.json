{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(CodigoRuta = trim(CodigoRuta),",
				"          NombreRuta = trim(NombreRuta),",
				"          Origen = trim(Origen),",
				"          Destino = trim(Destino)) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = iifNull(trim(RutaHistoricaId), concat('RH-', regexExtract(CodigoRuta, '(\\\\d+)', 1))),",
				"          VigenciaDesde = iif(   isNull(VigenciaDesde) || length(trim(toString(VigenciaDesde))) == 0,   toDate('2020-01-01'),   iif(     isInteger(trim(toString(VigenciaDesde))),     addDays(toDate('1899-12-30'), toInteger(trim(toString(VigenciaDesde)))),     coalesce(       toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd'),       toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy')     )   ) ),",
				"          VigenciaHasta = iif(   isNull(VigenciaHasta) || length(trim(toString(VigenciaHasta))) == 0,   toDate('2025-12-31'),   iif(     isInteger(trim(toString(VigenciaHasta))),     addDays(toDate('1899-12-30'), toInteger(trim(toString(VigenciaHasta)))),     coalesce(       toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd'),       toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy')     )   ) )) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}